{
  "name": "bayme.sh",
  "version": "0.0.1",
  "description": "BayMe.sh Website",
  "repository": "github:baymesh/baymesh-static-website",
  "homepage": "https://bayme.sh",
  "author": "BayMesh Authors",
  "license": "MIT",
  "bugs": "https://github.com/baymesh/baymesh-static-website/issues",
  "scripts": {
    "_build": "npm run _hugo-dev --",
    "_check:links": "echo IMPLEMENTATION PENDING for check-links; echo",
    "_hugo": "hugo --cleanDestinationDir",
    "_hugo-dev": "npm run _hugo -- -e dev -DFE",
    "_local": "npx cross-env HUGO_MODULE_WORKSPACE=docsy.work",
    "_serve": "npm run _hugo-dev -- --minify serve --renderToMemory",
    "build:preview": "npm run _hugo-dev -- --minify --baseURL \"${DEPLOY_PRIME_URL:-/}\"",
    "build:production": "npm run _hugo -- --minify",
    "build": "npm run _build -- ",
    "check:links:all": "HTMLTEST_ARGS= npm run _check:links",
    "check:links": "npm run _check:links",
    "clean": "rm -Rf public/* resources",
    "local": "npm run _local -- npm run",
    "make:public": "git init -b main public",
    "precheck:links:all": "npm run build",
    "precheck:links": "npm run build",
    "postbuild:preview": "npm run _check:links",
    "postbuild:production": "npm run _check:links",
    "serve": "npm run _serve",
    "test": "npm run check:links",
    "update:dep": "npm install --save-dev autoprefixer@latest postcss-cli@latest"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "cross-env": "^10.1.0",
    "postcss-cli": "^12.0.0"
  },
  "private": true,
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
